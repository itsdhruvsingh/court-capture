# Supabase (the same project as the SCL site; run supabase/migrations in order)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare R2 — where order and judgment PDFs are kept
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI summaries
OPENAI_API_KEY=
# Monthly ceiling on summary spend, US dollars (default 25)
AI_MONTHLY_BUDGET_USD=

# Signs extension connection codes. Defaults to SUPABASE_SECRET_KEY; set it to
# revoke every connected extension at once by changing it.
COURT_CAPTURE_SECRET=
