{
  "name": "court-capture",
  "version": "1.0.0",
  "private": true,
  "description": "Read Indian court records into a searchable database: District Court (eCourts) and Delhi High Court, captured by a browser extension with a person typing each captcha.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node scripts/test-district.mjs && node scripts/test-highcourt.mjs",
    "test:sql": "node scripts/test-sql.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "cheerio": "1.0.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.28.0",
    "next": "^16.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "embedded-postgres": "^14.23.0-beta.17",
    "postcss": "^8.5.28",
    "postgres": "^3.4.9",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
